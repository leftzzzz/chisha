{
  "name": "chisha",
  "version": "0.1.0",
  "private": true,
  "description": "今天吃啥 —— 基于 Agent 的餐厅推荐应用：自然语言理解目标、搜索附近餐厅、验证候选，再用转盘做最终选择",
  "license": "MIT",
  "author": "leftzzzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leftzzzz/chisha.git"
  },
  "bugs": {
    "url": "https://github.com/leftzzzz/chisha/issues"
  },
  "homepage": "https://github.com/leftzzzz/chisha#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "preview": "npx wrangler dev",
    "db:migrate:local": "npx wrangler d1 migrations apply chisha --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply chisha --remote",
    "deploy": "node scripts/wrangler-deploy-with-migrations.js deploy",
    "deploy:skip-migrations": "node scripts/wrangler-without-migrations.js deploy",
    "versions:upload": "node scripts/wrangler-deploy-with-migrations.js versions upload",
    "versions:upload:skip-migrations": "node scripts/wrangler-without-migrations.js versions upload",
    "wrangler:build": "node scripts/wrangler-build-with-migrations.js",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .next/cache/eslint/",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "node scripts/test-api.js",
    "eval": "jest --config jest.eval.config.js --runInBand",
    "eval:live-model-fixture-map": "EVAL_MODE=live-model-fixture-map jest --config jest.eval.config.js --runInBand",
    "eval:live-model-live-map": "EVAL_MODE=live-model-live-map jest --config jest.eval.config.js --runInBand",
    "eval:baseline": "EVAL_MODE=offline EVAL_UPDATE_BASELINE=1 jest --config jest.eval.config.js --runInBand",
    "docs:check": "node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/__tests__/check-docs.test.mjs",
    "check": "node scripts/check-setup.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.86",
    "@ai-sdk/openai-compatible": "^1.0.29",
    "ai": "^5.0.113",
    "fflate": "^0.8.2",
    "nanoid": "^5.1.6",
    "next": "^16.0.10",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.10",
    "@opennextjs/cloudflare": "^1.14.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "wrangler": "4.86.0"
  }
}
