# OpenAI API Configuration
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
# 可选：仅当兼容端点不支持 tools/tool_choice 时设为 functions
# OPENAI_TOOL_CALL_MODE=functions

# 模型分级（默认都继承 OPENAI_MODEL）
# OPENAI_MODEL_SUPERVISOR=
# OPENAI_MODEL_PLANNER=
# 候选验证调用量最大，可配便宜模型
# OPENAI_MODEL_EVALUATION=
# OPENAI_MODEL_KEYWORD=
# 可选：Qwen/DashScope 使用强制工具调用时会自动关闭 thinking mode；通常不要改
# QWEN_ENABLE_THINKING=false

# Amap (高德地图) API Configuration
# Web服务 API Key (用于后端 POI 搜索，类型选择"Web服务")
AMAP_API_KEY=...
# 高德 Web 服务请求削峰配置（按当前 Key 配额调整）
AMAP_MAX_QPS=4
AMAP_MAX_RETRIES=2
AMAP_SEARCH_CACHE_TTL_MS=120000
AMAP_DETAIL_CACHE_TTL_MS=86400000
AMAP_GEOCODE_CACHE_TTL_MS=3600000
# Web端 JS API Key (用于前端地图显示，类型选择"Web端(JS API)")
NEXT_PUBLIC_AMAP_KEY=...
# Web端 JS API Key 的运行时服务端别名（部署平台不做构建时注入时可用）
# AMAP_JS_API_KEY=...
# 安全密钥 (在高德控制台获取，用于 JS API 安全验证)
AMAP_SECURITY_CODE=...

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# 一轮内并行搜索：默认开启。设为 false 时每批只跑 1 个计划，行为与串行一致
# AGENT_PARALLEL_SEARCH=false
# AGENT_SEARCH_CONCURRENCY=3
# 首搜与关键词联想并发：默认开启。设为 false 时退回串行
# AGENT_CONCURRENT_FIRST_SEARCH=false
# SSE 心跳间隔（毫秒）。客户端无事件超时为 45s，两者需保持数倍关系
# AGENT_HEARTBEAT_MS=10000
# 强制走确定性分支（不调用模型）。测试默认开启
# AGENT_DETERMINISTIC=1
