# OpenAI-compatible model API (Alibaba Cloud Model Studio / Bailian)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生产优先使用业务空间专属域名：
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 不设置时使用角色默认值：supervisor/planner=qwen3.7-flash，evaluation/keyword=qwen-flash
# OPENAI_MODEL=qwen3.7-flash
# 可选：仅当兼容端点不支持 tools/tool_choice 时设为 functions
# OPENAI_TOOL_CALL_MODE=functions

# 模型分级（显式设置 OPENAI_MODEL 时默认继承该值）
# OPENAI_MODEL_SUPERVISOR=
# OPENAI_MODEL_PLANNER=
# 候选验证调用量最大，可配便宜模型
# OPENAI_MODEL_EVALUATION=
# OPENAI_MODEL_KEYWORD=

# Amap (高德地图) API Configuration
# Web服务 API Key (用于后端 POI 搜索，类型选择"Web服务")
AMAP_API_KEY=...
# 高德 Web 服务跨实例安全速率；上线前按控制台最小 QPS 的 70% 配置
AMAP_SAFE_QPS=4
# 兼容旧部署；AMAP_SAFE_QPS 未设置时才读取 AMAP_MAX_QPS
# AMAP_MAX_QPS=4
AMAP_MAX_INFLIGHT=6
AMAP_MAX_RETRIES=2
AMAP_DETAIL_CONCURRENCY=2
AMAP_SEARCH_CACHE_TTL_MS=120000
AMAP_DETAIL_CACHE_TTL_MS=86400000
AMAP_GEOCODE_CACHE_TTL_MS=3600000
# Web端 JS API Key (用于前端地图显示，类型选择"Web端(JS API)")
NEXT_PUBLIC_AMAP_KEY=...
# Web端 JS API Key 的运行时服务端别名（部署平台不做构建时注入时可用）
# AMAP_JS_API_KEY=...
# 安全密钥 (在高德控制台获取，用于 JS API 安全验证)
AMAP_SECURITY_CODE=...

# Public runtime protection
# 生产必需：至少 32 字符；可用 `openssl rand -base64 48` 生成
SESSION_OWNER_SECRET=replace-with-at-least-32-random-characters
AGENT_MAX_ACTIVE_RUNS=3
PROVIDER_MAX_WAIT_MS=3000
PROVIDER_LEASE_TTL_MS=120000
# 阿里云控制台数值未知时保持 RPM/TPM 为 0，仅启用严格在途上限
MODEL_MAX_INFLIGHT=4
MODEL_RPM_LIMIT=0
MODEL_TPM_LIMIT=0
OSM_SAFE_QPS=1
OSM_MAX_INFLIGHT=1

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# 一轮内并行搜索：默认开启。设为 false 时每批只跑 1 个计划，行为与串行一致
# AGENT_PARALLEL_SEARCH=false
# AGENT_SEARCH_CONCURRENCY=3
# 渐进评估每批数量；每计划默认预算为目标数 + buffer
# AGENT_EVALUATION_BATCH_SIZE=6
# AGENT_EVALUATION_BUFFER=4
# 可覆盖每计划预算，但不会低于目标数
# AGENT_EVALUATION_LIMIT=12
# 首搜与关键词联想并发：默认开启。设为 false 时退回串行
# AGENT_CONCURRENT_FIRST_SEARCH=false
# SSE 心跳间隔（毫秒）。客户端无事件超时为 45s，两者需保持数倍关系
# AGENT_HEARTBEAT_MS=10000
# 强制走确定性分支（不调用模型）。测试默认开启
# AGENT_DETERMINISTIC=1

# Agent eval mode. 默认 offline，不调用真实模型或地图。
# EVAL_MODE=offline
# live-model-live-map 还必须显式确认允许产生真实 Provider 请求与费用。
# EVAL_ALLOW_LIVE_PROVIDER=1
