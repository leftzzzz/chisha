// Cloudflare Workers 部署配置模板。
//
// 使用方式：
//   cp wrangler.jsonc.example wrangler.jsonc
//   npx wrangler d1 create chisha        # 输出 database_id，填到下面
//
// wrangler.jsonc 本身不进版本库：它含有你自己 Cloudflare 账号下的资源 ID，
// 提交上来只会让每个 fork 都指向别人的数据库。详见 docs/DEPLOYMENT.md。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chisha",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"secrets": {
		"required": [
			"AMAP_API_KEY",
			"AMAP_JS_API_KEY",
			"AMAP_SECURITY_CODE",
			"OPENAI_API_KEY",
			"OPENAI_BASE_URL",
			"OPENAI_MODEL"
		]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"build": {
		"command": "npm run wrangler:build"
	},
	"d1_databases": [
		{
			"binding": "CHISHA_DB",
			"database_name": "chisha",
			"database_id": "<npx wrangler d1 create chisha 输出的 id>"
		}
	]
}
